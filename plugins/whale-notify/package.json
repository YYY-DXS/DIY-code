{
  "name": "@local/whale-notify",
  "version": "1.0.0",
  "private": true,
  "description": "Chime and a cute whale card when a turn finishes or DSH needs your reply.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "assets",
    "widget",
    "启动鲸鱼娘桌宠.cmd",
    "安装开机自启.cmd",
    "卸载开机自启.cmd",
    "README.md",
    "ART_LICENSE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
