{
  "name": "@local/codex-history-bridge",
  "version": "1.0.1",
  "private": true,
  "description": "Import local Codex conversation history into the workspace as Markdown transcripts, an index, and an optional raw copy.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "scripts/import_codex_history.py",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
